includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8
    paths:
        - silvertrail.php
        - uninstall.php
        - includes
        - templates
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - tests/phpstan-ai-client.php
    # Filter callbacks can return anything, whatever the hook's docblock says.
    treatPhpDocTypesAsCertain: false
