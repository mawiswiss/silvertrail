{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.1",
	"plugins": [ "." ],
	"port": 8891,
	"testsPort": 8892,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true
	},
	"env": {
		"development": {
			"mappings": {
				"wp-content/mu-plugins": "./tests/samples"
			}
		},
		"tests": {
			"plugins": [ ".", "https://downloads.wordpress.org/plugin/wp-consent-api.latest-stable.zip" ],
			"mappings": {
				"wp-content/mu-plugins": "./tests/e2e/fixtures"
			}
		}
	}
}
