#: includes/Admin/Notices.php:140
#: includes/Admin/SettingsPage.php:196
#: includes/Admin/tabs/texts.php:26
msgid "Texts"
msgstr ""

#: includes/Admin/Help.php:181
msgid "Ship the texts with the theme as `silvertrail/texts-{locale}.json`, or `silvertrail/texts.json` for every language. The Texts tab shows the JSON with every key."
msgstr ""

