msgstr ""

#. Description of the plugin
#: silvertrail.php
msgid "A small cookie consent banner, and the backbone behind it for everything the site loads from other servers. Nothing loads before yes, accept and reject weigh the same, and developers configure it in code."
msgstr ""

#. Author of the plugin
#: silvertrail.php
msgid "Marc Wieland"
msgstr ""

#. Author URI of the plugin
#: silvertrail.php
msgid "https://marcwieland.name"
msgstr ""

