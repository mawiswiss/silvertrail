#. Plugin Name of the plugin
#: silvertrail.php
msgid "Silvertrail"
msgstr ""

#. Plugin URI of the plugin
#: silvertrail.php
msgid "https://github.com/mawiswiss/silvertrail"
msgstr ""

#. Description of the plugin
#: silvertrail.php
msgid "A small cookie consent banner. Nothing loads before yes, accept and reject weigh the same, and developers configure it in code."
msgstr ""

#. Author of the plugin
#: silvertrail.php
msgid "Marc Wieland"
msgstr ""

