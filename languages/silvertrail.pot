msgstr ""

#. Description of the plugin
#: silvertrail.php
msgid "A small cookie consent banner. Nothing loads before yes, accept and reject weigh the same, and developers configure it in code."
msgstr ""

#. Author of the plugin
#: silvertrail.php
msgid "Marc Wieland"
msgstr ""

#. Author URI of the plugin
