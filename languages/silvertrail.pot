#: includes/Admin/Help.php:211
#: includes/Admin/tabs/design.php:216
#: includes/Admin/tabs/design.php:219
msgid "Floating button"
msgstr ""

#: includes/Admin/Help.php:212
msgid "Both corners on the Design tab hide the button on pages with another link to `#silvertrail`. The `silvertrail_settings` filter shows it on every page."
msgstr ""

#: includes/Admin/Help.php:215
msgid "`floating_button`: `never`, the default, `auto` for pages without a link to `#silvertrail`, or `always`."
msgstr ""

#: includes/Admin/Help.php:216
msgid "`floating_position`: `left` or `right`."
msgstr ""

#: includes/Admin/Help.php:217
msgid "The `silvertrail_reopen_icon` filter swaps the icon for inline SVG or an `<img>`. The button keeps its label for screen readers."
msgstr ""

#: includes/Admin/Help.php:218
msgid "Style it in the theme’s `silvertrail/silvertrail.css` through `.silvertrail-reopen`, `.silvertrail-reopen--left` and `.silvertrail-reopen--right`."
msgstr ""

