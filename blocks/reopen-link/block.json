{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "silvertrail/reopen-link",
	"title": "Silvertrail Link",
	"category": "widgets",
	"description": "A link that opens Silvertrail's privacy settings again.",
	"keywords": [ "silvertrail", "cookie", "consent", "privacy" ],
	"textdomain": "silvertrail",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./editor.js",
	"render": "file:./render.php"
}
